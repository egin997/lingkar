# Values exposed to the browser. Use the publishable key, never secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only trusted Phase 2 mutations. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only. Generate one stable 32-byte base64 key per environment.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_a_stable_server_only_key
